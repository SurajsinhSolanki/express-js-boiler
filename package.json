{
    "name": "boilerplate",
    "version": "1",
    "description": "An Express boilerplate backend",
    "author": "Surajsinh",
    "repository": "SurajsinhSolanki/express-js-boiler",
    "license": "MIT",
    "main": "index.ts",
    "private": true,
    "scripts": {
        "build": "tsup",
        "start:dev": "tsx watch --clear-screen=false src/index.ts | pino-pretty",
        "start:prod": "node dist/index.js",
        "lint": "biome lint",
        "lint:fix": "biome lint --fix",
        "format": "biome format --write",
        "sample-env": "generate-sample-env .env example.env",
        "seed": "ts-node prisma/seeds/seed.ts"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "7.3.0",
        "@prisma/client": "^6.5.0",
        "bcryptjs": "^3.0.2",
        "compression": "^1.8.0",
        "cors": "2.8.5",
        "dotenv": "16.4.7",
        "express": "^4.21.2",
        "express-rate-limit": "7.5.0",
        "generate-sample-env": "^1.0.0",
        "helmet": "8.1.0",
        "pino": "9.6.0",
        "pino-http": "10.4.0",
        "prisma": "^6.5.0",
        "swagger-ui-express": "5.0.1",
        "zod": "3.24.2"
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@types/compression": "^1.7.5",
        "@types/cors": "2.8.17",
        "@types/express": "5.0.1",
        "@types/node": "^22.13.13",
        "@types/supertest": "6.0.3",
        "@types/swagger-ui-express": "4.1.8",
        "pino-pretty": "13.0.0",
        "supertest": "7.1.0",
        "ts-node": "^10.9.2",
        "tsup": "8.4.0",
        "tsx": "4.19.3",
        "typescript": "5.8.2"
    },
    "tsup": {
        "entry": [
            "src"
        ],
        "splitting": false,
        "sourcemap": true,
        "clean": true
    }
}
