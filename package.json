{
  "name": "boilerplate",
  "version": "1",
  "description": "An Express boilerplate backend",
  "author": "Surajsinh",
  "repository": "SurajsinhSolanki/express-js-boiler",
  "license": "MIT",
  "main": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsup",
    "start:dev": "tsx watch --clear-screen=false src/index.ts | pino-pretty",
    "start:prod": "node dist/index.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "sample-env": "generate-sample-env .env example.env",
    "seed": "ts-node prisma/seeds/seed.ts",
    "prepare": "husky install",
    "coverage": "vitest run --coverage",
    "sonar": "npm run coverage && sonar-scanner"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cors": "2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "7.5.0",
    "generate-sample-env": "^1.0.0",
    "helmet": "8.1.0",
    "morgan": "^1.10.1",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "prisma": "^6.5.0",
    "swagger-ui-express": "5.0.1",
    "vitest": "^3.2.4",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.13.13",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "nodemon": "^3.1.10",
    "pino-pretty": "13.0.0",
    "prettier": "^3.6.2",
    "sonarqube-scanner": "^4.3.0",
    "supertest": "7.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "8.4.0",
    "tsx": "4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "tsup": {
    "entry": [
      "src"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true,
    "format": [
      "esm"
    ]
  }
}
