{
  "name": "boilerplate",
  "version": "1",
  "description": "An Express boilerplate backend",
  "author": "Surajsinh",
  "repository": "SurajsinhSolanki/express-js-boiler",
  "license": "MIT",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsup",
    "start:dev": "tsx watch --clear-screen=false src/index.ts | pino-pretty",
    "start:prod": "node dist/index.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "sample-env": "generate-sample-env .env example.env",
    "prepare": "husky",
    "coverage": "vitest run --coverage",
    "sonar": "pnpm run coverage && sonar-scanner",
    "test": "vitest"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "generate-sample-env": "^1.0.0",
    "helmet": "^8.1.0",
    "i18next": "^25.6.2",
    "i18next-http-middleware": "^3.8.2",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongoose": "^8.19.4",
    "morgan": "^1.10.1",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "openapi-types": "^12.1.3",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "vitest": "^3.2.4",
    "zod": "^4.1.12",
    "zod-openapi": "^5.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/compression": "^1.8.1",
    "@types/cors": "2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/morgan": "^1.9.10",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.6",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "nodemon": "^3.1.11",
    "pino-pretty": "13.1.1",
    "rimraf": "^6.1.0",
    "sonarqube-scanner": "^4.3.2",
    "supertest": "7.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": [
      "biome check --write"
    ]
  },
  "tsup": {
    "entry": [
      "src"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true,
    "format": [
      "cjs"
    ]
  }
}
