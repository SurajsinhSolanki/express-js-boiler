<!DOCTYPE html>
<html>
<head>
    <title>Email Verification</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f4f4; margin: 0; padding: 0; }
        .container { max-width: 600px; margin: 20px auto; background-color: #ffffff; padding: 20px; border-radius: 8px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); }
        .header { background-color: #007bff; color: #ffffff; padding: 10px 20px; text-align: center; border-radius: 8px 8px 0 0; }
        .content { padding: 20px; text-align: center; }
        .button { display: inline-block; padding: 10px 20px; margin-top: 20px; background-color: #28a745; color: #ffffff; text-decoration: none; border-radius: 5px; }
        .footer { margin-top: 20px; font-size: 12px; color: #888888; text-align: center; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h2>Verify Your Email Address</h2>
        </div>
        <div class="content">
            <p>Hello <%= name %>,</p>
            <p>Thank you for registering with our service. Please click the button below to verify your email address:</p>
            <a href="<%= verificationLink %>" class="button">Verify Email</a>
            <p>If you did not request this, please ignore this email.</p>
            <p>This link will expire in <%= expiresInMinutes %> minutes.</p>
        </div>
        <div class="footer">
            <p>&copy; <%= year %> Your Company. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
